# HTTP shell. Inject the real key from Secret Manager; never bundle it into public/.
PORT=8080
APP_MODE=fixture
DEMO_KEY=replace-with-at-least-24-random-characters
ENTITLEMENT_SECRET=replace-with-a-distinct-random-secret
# Comma-separated old verification keys kept only until issued tokens expire.
ENTITLEMENT_PREVIOUS_SECRETS=
PUBLIC_DIR=public

# fixture is deterministic and needs no model credentials. Use live only in the deployed demo.
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global

# Persistence and chain configuration.
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_NAMESPACE=v0
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
MERCHANT_OWNER=replace-with-devnet-merchant-owner
MERCHANT_USDC_ATA=replace-with-devnet-merchant-usdc-ata

# APP_MODE=live requires these variables. Configure Cloud Run to inject each
# value from its matching Secret Manager resource; never commit the values.
# DEMO_KEY must contain at least 24 characters.
# ENTITLEMENT_SECRET must be a distinct random value of at least 32 characters.
SPONSOR_SECRET_KEY=
BUYER_A_SECRET_KEY=
BUYER_B_SECRET_KEY=
BUYER_C_SECRET_KEY=

# Suggested Secret Manager resources for deployment configuration:
# Pin deployed revisions to an explicit enabled version instead of `latest`.
# projects/PROJECT/secrets/mandate-pool-demo-key/versions/1        -> DEMO_KEY
# projects/PROJECT/secrets/mandate-pool-fee-sponsor/versions/1     -> SPONSOR_SECRET_KEY
# projects/PROJECT/secrets/mandate-pool-buyer-a/versions/1         -> BUYER_A_SECRET_KEY
# projects/PROJECT/secrets/mandate-pool-buyer-b/versions/1         -> BUYER_B_SECRET_KEY
# projects/PROJECT/secrets/mandate-pool-buyer-c/versions/1         -> BUYER_C_SECRET_KEY
# projects/PROJECT/secrets/mandate-pool-entitlement/versions/1     -> ENTITLEMENT_SECRET
