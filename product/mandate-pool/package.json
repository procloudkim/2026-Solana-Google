{
  "name": "mandate-pool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "devnet:create-atas": "node scripts/create-devnet-atas.mjs",
    "evidence:export": "node dist/cli/evidence-export.js",
    "localnet:smoke": "tsx scripts/localnet-smoke.ts",
    "wallets:provision": "node scripts/provision-devnet-wallets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.0",
    "@google/adk": "^1.5.0",
    "@google/genai": "^2.15.0",
    "@hono/node-server": "^2.0.12",
    "@solana-program/token": "^0.9.0",
    "@solana/kit": "^5.1.0",
    "hono": "^4.9.8",
    "json-canonicalize": "^2.0.0",
    "pino": "^9.12.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "fast-check": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "adm-zip": "0.6.0"
  }
}
