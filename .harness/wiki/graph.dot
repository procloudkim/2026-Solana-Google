  "official-claim:p1-02" [label="A demo video must be no longer than three minutes\\n[official_claim]", shape="note"];
  "official-claim:p1-03" [label="The required top-level artifacts are product introduction, GitHub, and demo video\\n[official_claim]", shape="note"];
  "official-claim:p1-04" [label="A full on-chain payment demonstration is only a bonus\\n[official_claim]", shape="note"];
  "official-claim:p1-05" [label="A personal Gmail account is required to participate\\n[official_claim]", shape="note"];
  "official-claim:p1-06" [label="Google Cloud USD 300 credit cannot pay for Gemini API use\\n[official_claim]", shape="note"];
  "official-claim:p2-01" [label="pay.sh requires no signup, account, or API key\\n[official_claim]", shape="note"];
  "official-claim:p2-02" [label="The command is npx followed separately by @solana/pay\\n[official_claim]", shape="note"];
  "official-claim:p2-03" [label="The install command is brew install pay.\\n[official_claim]", shape="note"];
  "official-claim:p2-04" [label="Localnet, Testnet, Devnet, and Mainnet have distinct development roles\\n[official_claim]", shape="note"];
  "official-claim:p2-05" [label="Mainnet is necessary for the hackathon deployment stage\\n[official_claim]", shape="note"];
  "official-claim:p2-06" [label="All displayed partner and ecosystem metrics are current\\n[official_claim]", shape="note"];
  "official-claim:p3-01" [label="A2A, commerce protocols, authorization protocols, and payment rails occupy different layers\\n[official_claim]", shape="note"];
  "official-claim:p3-02" [label="pay.sh supports x402 and MPP with local wallet authorization\\n[official_claim]", shape="note"];
  "official-claim:p3-03" [label="Current x402 uses the X-PAYMENT header\\n[official_claim]", shape="note"];
  "official-claim:p3-04" [label="x402 is community-first while MPP is enterprise-first\\n[official_claim]", shape="note"];
  "official-claim:p3-05" [label="N x402 requests always require N on-chain transactions while MPP always requires exactly two\\n[official_claim]", shape="note"];
  "official-claim:p3-06" [label="A2A and MCP are complementary agent-agent and agent-tool protocols\\n[official_claim]", shape="note"];
  "official-claim:p3-07" [label="Displayed market transaction metrics are reproducible current facts\\n[official_claim]", shape="note"];
  "official-claim:t1-01" [label="Deadline is Aug 3 23:59 and finalists are announced Aug 7\\n[official_claim]", shape="note"];
  "official-claim:t1-02" [label="Demo Day is Aug 20\\n[official_claim]", shape="note"];
  "official-claim:t1-03" [label="Submission has product introduction, GitHub repository, and demo video\\n[official_claim]", shape="note"];
  "official-claim:t1-04" [label="A live deployment URL is recommended\\n[official_claim]", shape="note"];
  "official-claim:t1-05" [label="Participants can use a USD 300 Google Cloud credit\\n[official_claim]", shape="note"];
  "official-claim:t1-06" [label="A real agent payment should be shown live\\n[official_claim]", shape="note"];
  "official-claim:t2-01" [label="pay.sh sandbox payment completed\\n[official_claim]", shape="note"];
  "official-claim:t2-02" [label="Solana fee is approximately 0.001 cent\\n[official_claim]", shape="note"];
  "official-claim:t2-03" [label="pay.sh needs no signup, account, API key, or subscription\\n[official_claim]", shape="note"];
  "official-claim:t2-04" [label="pay.sh works without code changes\\n[official_claim]", shape="note"];
  "official-claim:t2-05" [label="Testnet targets validator/client testing while application work uses Localnet or Devnet\\n[official_claim]", shape="note"];
  "official-claim:t2-06" [label="Specific partner and market metrics are current\\n[official_claim]", shape="note"];
  "official-claim:t3-01" [label="Build week ends Mar 3\\n[official_claim]", shape="note"];
